# Illustrative HTTPS-only host. DNS-01 or operator-managed certificates avoid an
# HTTP-01 challenge listener; additionally block TCP/80 for this host at the
# network edge. A shared IP with another HTTP site is not strictly HTTPS-only.
# This global option affects every site in the Caddy process. If merging into a
# shared Caddyfile, coordinate its existing global block and redirect policy;
# do not paste another global block or silently disable other sites' redirects.
{
	auto_https disable_redirects
}
https://dsh.example {
	# DSH 0.2.0-rc.2's native cookie does not set Secure. Normalize an
	# existing Secure attribute before appending exactly once to dsh-auth-*.
	# Caddy cannot change cookies that a browser already holds.
	header {
		>Strict-Transport-Security "max-age=31536000"
		>Set-Cookie "^(dsh-auth-[^\r\n]*?);[ \t]*Secure((?:;[^\r\n]*)?)$" "$1$2"
		>Set-Cookie "^(dsh-auth-[^\r\n]*)$" "$1; Secure"
	}

	# Strip browser-supplied credentials, proxy credentials, the dedicated client
	# address, and common identity aliases before any handler runs.
	request_header -Authorization
	request_header -Proxy-Authorization
	request_header -X-Dsh-Oidc-Client-Ip
	request_header -X-Forwarded-User
	request_header -X-Forwarded-Email
	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email
	request_header -X-Remote-User
	request_header -Remote-User

	@oidcEndpoints path /auth/login /auth/callback /auth/check /auth/logout
	route {
		# Only the four registered OIDC endpoints bypass admission.
		handle @oidcEndpoints {
			reverse_proxy 127.0.0.1:3080 {
				header_up Host {host}
				header_up X-Dsh-Oidc-Client-Ip {remote_host}
			}
		}
		# Do not let a future DSH route under /auth/ inherit the exception.
		handle /auth/* {
			respond "not found" 404
		}
		handle {
			forward_auth 127.0.0.1:3080 {
				uri /auth/check
				# Strip upgrade headers on this GET-only *auth subrequest*.
				# Preserve them on the application proxy below for WebSockets.
				header_up -Connection
				header_up -Upgrade
				header_up Host {host}
				header_up X-Dsh-Oidc-Client-Ip {remote_host}
			}
			reverse_proxy 127.0.0.1:3080 {
				header_up Host {host}
			}
		}
	}

	# Production logging must omit/redact query strings because DSH's temporary
	# native bootstrap URL contains a bearer token.
	log {
		format filter {
			wrap json
			fields {
				request>uri query delete
			}
		}
	}
}
